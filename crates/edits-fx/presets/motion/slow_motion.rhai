//! id = "slow_motion"
//! name = "Slow Motion"
//! scope = "clip"
//! category = "motion"
//! description = "Constant slow motion (stretches the clip's source over its duration)."
//! tags = ["slow motion", "speed"]
//! params = [ { name = "speed", type = "float", default = 0.4 } ]
clip.speed = args.speed;
